<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set up CallJarvis"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your name"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />
    <EditText
        android:id="@+id/nameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. Alex"
        android:inputType="textPersonName"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your phone number"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />
    <EditText
        android:id="@+id/phoneInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. 9876543210"
        android:inputType="phone"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Assistant voice"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />
    <RadioGroup
        android:id="@+id/voiceGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">
        <RadioButton
            android:id="@+id/voiceFemale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Female"
            android:checked="true"
            android:layout_marginEnd="24dp" />
        <RadioButton
            android:id="@+id/voiceMale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Male" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Who should CallJarvis pick up for?"
        android:textSize="14sp"
        android:layout_marginBottom="4dp" />
    <RadioGroup
        android:id="@+id/filterGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="28dp">
        <RadioButton
            android:id="@+id/filterEveryone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Everyone (strangers + contacts)"
            android:checked="true" />
        <RadioButton
            android:id="@+id/filterStrangersOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Only unknown numbers (strangers)" />
        <RadioButton
            android:id="@+id/filterContactsOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Only saved contacts" />
        <RadioButton
            android:id="@+id/filterOff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Off (don't screen calls)" />
    </RadioGroup>

    <Button
        android:id="@+id/doneBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Done" />

</LinearLayout>
</ScrollView>
